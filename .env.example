# Security settings
MAX_AGE_SECONDS=60

# Health check settings (test_client/health_check.py)
# HEALTH_CHECK_URL=https://httpbin.org/get
# HEALTH_TIMEOUT=10
# TAILSCALE_FUNNEL_URL=https://your-host.tail-scale.ts.net
# TAILSCALE_FUNNEL_PORT=10000
# TAILSCALE_BIN=tailscale

# --restart settings (test_client/health_check.py --restart)
# GATEWAY_RESTART_CMD=docker compose restart gateway
# TAILSCALE_RESTART_CMD=./run_tailscale.sh
# Exponential backoff for the post-restart re-check loop
# (defaults: 2s, 4s, 8s, 16s, 32s — up to ~62s total wait)
# RESTART_BACKOFF_INITIAL=2
# RESTART_BACKOFF_FACTOR=2
# RESTART_BACKOFF_MAX_ATTEMPTS=5    # 0 = retry forever until PASS
# RESTART_BACKOFF_MAX_DELAY=300     # per-attempt cap; plateau in infinite mode

# MQTT failure alerts (published when a health check ends in a non-zero state)
# MQTT_BROKER_HOST=192.168.1.91     # required; alerts stay off if unset
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# HEALTH_ALERT_ENABLED=auto         # auto | true | false
# HEALTH_ALERT_MQTT_TOPIC_PREFIX=encryption-gateway/health
# HEALTH_ALERT_MQTT_QOS=1
# HEALTH_ALERT_MQTT_RETAIN=false
# HEALTH_ALERT_MQTT_TIMEOUT=5
